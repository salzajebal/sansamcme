# Docker Compose production configuration.
# Copy this file to .env and replace every placeholder before first deploy.
# Never commit the real .env file.

# PostgreSQL container settings
POSTGRES_DB=cme_group
POSTGRES_USER=cme_app
POSTGRES_PASSWORD=replace_with_a_long_random_password

# The hostname must stay "db" because it is the internal Docker Compose service name.
DATABASE_URL=postgresql://cme_app:replace_with_a_long_random_password@db:5432/cme_group

# Application settings
LOG_LEVEL=info

# Public HTTP port for the website. Use 80 unless another web server owns it.
WEB_PORT=80